@echo off
rem Runs the FS95 Win64 Patch. Asks for administrator rights, which are needed
rem when the game is installed under Program Files.
net session >nul 2>&1
if errorlevel 1 (
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0FS95-Win64-Patch.ps1" %*
echo.
pause
